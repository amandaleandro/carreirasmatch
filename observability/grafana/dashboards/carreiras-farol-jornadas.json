    {
      "type": "stat",
      "title": "Análise de currículo (IA) — sucesso 1h",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(carreiras_analysis_total{outcome=\"success\"}[1h])) / clamp_min(sum(rate(carreiras_analysis_total[1h])), 0.000001)"
        }
      ]
    },
