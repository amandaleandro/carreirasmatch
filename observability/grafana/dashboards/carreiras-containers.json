{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Carreiras Match - Containers",
  "uid": "carreiras-containers",
  "tags": ["carreiras-match", "containers"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(container_last_seen{name=~\"carreiras-match.*\"}, name)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU por container (cores)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 15 } } },
      "targets": [ { "refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$name\"}[5m]))", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Memória (working set)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15 } } },
      "targets": [ { "refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$name\"})", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Rede recebida (bytes/s)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [ { "refId": "A", "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$name\"}[5m]))", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Rede enviada (bytes/s)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [ { "refId": "A", "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$name\"}[5m]))", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Throttling de CPU (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [ { "refId": "A", "expr": "sum by (name) (rate(container_cpu_cfs_throttled_periods_total{name=~\"$name\"}[5m])) / clamp_min(sum by (name) (rate(container_cpu_cfs_periods_total{name=~\"$name\"}[5m])), 1) * 100", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "table",
      "title": "Últimos reinícios (container_start_time)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [ { "refId": "A", "expr": "container_start_time_seconds{name=~\"carreiras-match.*\"} * 1000", "format": "table", "instant": true } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "id": true, "image": true, "instance": true, "job": true }, "renameByName": { "name": "container", "Value": "iniciado em" } } }
      ]
    }
  ]
}
