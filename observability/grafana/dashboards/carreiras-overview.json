{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Carreiras Match - Visão Geral",
  "uid": "carreiras-overview",
  "tags": ["carreiras-match"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "App online",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"carreiras-app\"}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OFF", "color": "red" }, "1": { "text": "ON", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Análises / min (por resultado)",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(carreiras_analysis_total[5m])) * 60", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duração da análise (p50 / p95)",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(carreiras_analysis_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(carreiras_analysis_duration_seconds_bucket[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Caddy - requests/s por status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (code) (rate(caddy_http_request_duration_seconds_count{server=\"srv0\"}[5m]))", "legendFormat": "{{code}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node.js - heap usado",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "expr": "nodejs_heap_size_used_bytes{job=\"carreiras-app\"}", "legendFormat": "heap usado" },
        { "refId": "B", "expr": "nodejs_heap_size_total_bytes{job=\"carreiras-app\"}", "legendFormat": "heap total" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host - uso de CPU (%)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } },
      "targets": [
        { "refId": "A", "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "cpu" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host - memória usada (%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } },
      "targets": [
        { "refId": "A", "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "memória" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Containers - memória",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"carreiras-match.*\"})", "legendFormat": "{{name}}" }
      ]
    },
    {
      "type": "logs",
      "title": "Logs do app (Loki)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{container=\"carreiras-match-app\"}" }
      ]
    }
  ]
}
