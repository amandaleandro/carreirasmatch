{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Carreiras Match - Logs",
  "uid": "carreiras-logs",
  "tags": ["carreiras-match", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(container)",
        "regex": "/carreiras-match.*/",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "busca",
        "type": "textbox",
        "label": "filtro (regex)",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Linhas de log / s por container",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 25, "stacking": { "mode": "normal" } } } },
      "targets": [ { "refId": "A", "expr": "sum by (container) (rate({container=~\"$container\"}[$__auto]))", "legendFormat": "{{container}}" } ]
    },
    {
      "type": "stat",
      "title": "Erros/min (todos os containers carreiras)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] }, "color": { "mode": "thresholds" } } },
      "targets": [ { "refId": "A", "expr": "sum(rate({container=~\"carreiras-match.*\"} |~ \"(?i)(error|exception|fatal|unhandled|econnrefused|timeout)\" [1m])) * 60" } ]
    },
    {
      "type": "logs",
      "title": "Erros e warnings (stack carreiras)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [ { "refId": "A", "expr": "{container=~\"carreiras-match.*\"} |~ \"(?i)(error|exception|fatal|unhandled|econnrefused|timeout|warn)\"" } ]
    },
    {
      "type": "logs",
      "title": "Log ao vivo (container selecionado, filtro opcional)",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [ { "refId": "A", "expr": "{container=~\"$container\"} |~ \"(?i)$busca\"" } ]
    }
  ]
}
