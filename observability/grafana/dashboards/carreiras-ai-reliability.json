{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Carreiras Match - IA Confiabilidade & Roteamento",
  "uid": "carreiras-ai-reliability",
  "tags": ["carreiras-match", "ia", "confiabilidade"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [{
      "name": "operation", "label": "Operação", "type": "query", "includeAll": true, "multi": true,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "query": { "query": "label_values(carreiras_ai_provider_calls_total, operation)", "refId": "operation-var" },
      "current": { "text": "All", "value": "$__all" }
    }]
  },
  "panels": [
    { "type": "row", "title": "Saúde da IA", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "type": "stat", "title": "Taxa de sucesso (24h)", "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.98 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(increase(carreiras_ai_provider_calls_total{outcome=\"success\",operation=~\"$operation\"}[24h])) / clamp_min(sum(increase(carreiras_ai_provider_calls_total{operation=~\"$operation\"}[24h])), 1)", "legendFormat": "sucesso" }]
    },
    {
      "type": "stat", "title": "Falhas (24h)", "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(increase(carreiras_ai_provider_calls_total{outcome=\"error\",operation=~\"$operation\"}[24h]))", "legendFormat": "falhas" }]
    },
    {
      "type": "stat", "title": "Provedores ativos", "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "count(sum by (provider) (increase(carreiras_ai_provider_calls_total{operation=~\"$operation\"}[24h])) > 0)", "legendFormat": "provedores" }]
    },
    {
      "type": "stat", "title": "Uso gratuito (24h)", "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(increase(carreiras_ai_provider_calls_total{provider=~\"groq|cerebras|gemini\",outcome=\"success\",operation=~\"$operation\"}[24h])) / clamp_min(sum(increase(carreiras_ai_provider_calls_total{outcome=\"success\",operation=~\"$operation\"}[24h])), 1)", "legendFormat": "gratuito" }]
    },
    {
      "type": "stat", "title": "Cache efetivo (24h)", "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(increase(carreiras_ai_cache_events_total{result=~\"hit|in_flight\",operation=~\"$operation\"}[24h])) / clamp_min(sum(increase(carreiras_ai_cache_events_total{operation=~\"$operation\"}[24h])), 1)", "legendFormat": "cache" }]
    },
    {
      "type": "stat", "title": "Latência p95", "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(carreiras_ai_provider_duration_seconds_bucket{outcome=\"success\",operation=~\"$operation\"}[15m])))", "legendFormat": "p95" }]
    },
    { "type": "row", "title": "Roteamento e fallback", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "Chamadas por provedor e resultado", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 20 } } },
      "targets": [{ "refId": "A", "expr": "sum by (provider, outcome) (rate(carreiras_ai_provider_calls_total{operation=~\"$operation\"}[5m]))", "legendFormat": "{{provider}} / {{outcome}}" }]
    },
    {
      "type": "barchart", "title": "Sucesso por provedor (24h)", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "orientation": "horizontal", "showValue": "always" },
      "targets": [{ "refId": "A", "expr": "sum by (provider) (increase(carreiras_ai_provider_calls_total{outcome=\"success\",operation=~\"$operation\"}[24h]))", "legendFormat": "{{provider}}", "instant": true }]
    },
    {
      "type": "bargauge", "title": "Taxa de sucesso por provedor", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1 } },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [{ "refId": "A", "expr": "sum by (provider) (increase(carreiras_ai_provider_calls_total{outcome=\"success\",operation=~\"$operation\"}[24h])) / clamp_min(sum by (provider) (increase(carreiras_ai_provider_calls_total{operation=~\"$operation\"}[24h])), 1)", "legendFormat": "{{provider}}" }]
    },
    {
      "type": "timeseries", "title": "Latência p95 por provedor", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2, "custom": { "fillOpacity": 10 } } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (provider, le) (rate(carreiras_ai_provider_duration_seconds_bucket{outcome=\"success\",operation=~\"$operation\"}[10m])))", "legendFormat": "{{provider}}" }]
    },
    { "type": "row", "title": "Eficiência", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "Tokens por minuto", "gridPos": { "h": 9, "w": 8, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 15 } } },
      "targets": [{ "refId": "A", "expr": "sum by (provider, direction) (rate(carreiras_ai_tokens_total{operation=~\"$operation\"}[5m])) * 60", "legendFormat": "{{provider}} / {{direction}}" }]
    },
    {
      "type": "timeseries", "title": "Eventos de cache", "gridPos": { "h": 9, "w": 8, "x": 8, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 15 } } },
      "targets": [{ "refId": "A", "expr": "sum by (result) (rate(carreiras_ai_cache_events_total{operation=~\"$operation\"}[5m]))", "legendFormat": "{{result}}" }]
    },
    {
      "type": "table", "title": "Modelos usados na janela", "gridPos": { "h": 9, "w": 8, "x": 16, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "showHeader": true },
      "targets": [{ "refId": "A", "expr": "sum by (provider, model, operation, outcome) (increase(carreiras_ai_provider_calls_total{operation=~\"$operation\"}[$__range]))", "legendFormat": "{{provider}} / {{model}} / {{operation}} / {{outcome}}", "instant": true }]
    }
  ]
}
