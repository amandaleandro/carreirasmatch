          "legendFormat": "ativas"
        }
      ],
      "description": "Quantas pessoas pagam hoje pela assinatura (recorrente). É a receita recorrente da empresa."
    },
    {
      "type": "stat",
      "title": "Conversão para assinatura",
      "description": "Assinaturas ativas / usuários cadastrados.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
