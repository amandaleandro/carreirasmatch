{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Carreiras Match — App & Borda",
  "uid": "carreiras-app-edge",
  "tags": ["carreiras-match", "app"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row", "title": "Borda (Caddy)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests/s por status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [ { "refId": "A", "expr": "sum by (code) (rate(caddy_http_request_duration_seconds_count{server=\"srv0\"}[5m]))", "legendFormat": "{{code}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Latência na borda (p50/p95/p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{server=\"srv0\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{server=\"srv0\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{server=\"srv0\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests em voo",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(caddy_http_requests_in_flight{server=\"srv0\"})", "legendFormat": "em voo" } ]
    },
    {
      "type": "timeseries",
      "title": "Requests/s por handler",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [ { "refId": "A", "expr": "sum by (handler) (rate(caddy_http_request_duration_seconds_count[5m]))", "legendFormat": "{{handler}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Taxa de erros 5xx/s",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [ { "refId": "A", "expr": "sum(rate(caddy_http_request_duration_seconds_count{code=~\"5..\"}[5m]))", "legendFormat": "5xx" } ]
    },
    {
      "type": "row", "title": "Negócio (análises)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "collapsed": false, "panels": []
    },
    {
      "type": "timeseries",
      "title": "Análises / min por resultado",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (rate(carreiras_analysis_total[5m])) * 60", "legendFormat": "{{outcome}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Análises por momento profissional (/min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (career_track) (rate(carreiras_analysis_total{outcome=\"success\"}[5m])) * 60", "legendFormat": "{{career_track}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Duração da análise (p50/p95/p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(carreiras_analysis_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(carreiras_analysis_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(carreiras_analysis_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "stat",
      "title": "Taxa de erro nas análises (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 } ] }, "color": { "mode": "thresholds" } } },
      "targets": [ { "refId": "A", "expr": "sum(rate(carreiras_analysis_total{outcome=\"error\"}[30m])) / clamp_min(sum(rate(carreiras_analysis_total[30m])), 0.0001) * 100" } ]
    },
    {
      "type": "row", "title": "Runtime Node.js", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }, "collapsed": false, "panels": []
    },
    {
      "type": "timeseries",
      "title": "Heap (bytes)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "expr": "nodejs_heap_size_used_bytes{job=\"carreiras-app\"}", "legendFormat": "usado" },
        { "refId": "B", "expr": "nodejs_heap_size_total_bytes{job=\"carreiras-app\"}", "legendFormat": "total" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event loop lag (p90)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "refId": "A", "expr": "nodejs_eventloop_lag_p90_seconds{job=\"carreiras-app\"}", "legendFormat": "lag p90" } ]
    },
    {
      "type": "timeseries",
      "title": "CPU do processo (%)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [ { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"carreiras-app\"}[5m]) * 100", "legendFormat": "cpu" } ]
    }
  ]
}
