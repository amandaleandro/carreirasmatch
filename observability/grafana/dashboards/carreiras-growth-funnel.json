{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Carreiras Match - Crescimento & Funil",
  "uid": "carreiras-growth-funnel",
  "tags": ["carreiras-match", "negócio", "crescimento"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [{
      "name": "period", "label": "Janela", "type": "custom", "query": "24h,7d,30d",
      "current": { "text": "30d", "value": "30d" },
      "options": [
        { "text": "24h", "value": "24h", "selected": false },
        { "text": "7d", "value": "7d", "selected": false },
        { "text": "30d", "value": "30d", "selected": true }
      ]
    }]
  },
  "panels": [
    { "type": "row", "title": "Aquisição e ativação — $period", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "type": "stat", "title": "Visualizações", "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "carreiras_business_created{entity=\"page_views\",period=\"$period\"}", "legendFormat": "views" }]
    },
    {
      "type": "stat", "title": "Novos leads", "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "carreiras_business_created{entity=\"leads\",period=\"$period\"}", "legendFormat": "leads" }]
    },
    {
      "type": "stat", "title": "Novos usuários", "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "carreiras_business_created{entity=\"users\",period=\"$period\"}", "legendFormat": "usuários" }]
    },
    {
      "type": "stat", "title": "Novos currículos", "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "carreiras_business_created{entity=\"resumes\",period=\"$period\"}", "legendFormat": "currículos" }]
    },
    {
      "type": "stat", "title": "Novas análises", "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "carreiras_business_created{entity=\"analyses\",period=\"$period\"}", "legendFormat": "análises" }]
    },
    {
      "type": "stat", "title": "Análises por novo usuário", "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "carreiras_business_created{entity=\"analyses\",period=\"$period\"} / clamp_min(carreiras_business_created{entity=\"users\",period=\"$period\"}, 1)", "legendFormat": "ativação" }]
    },
    { "type": "row", "title": "Conversões acumuladas", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false, "panels": [] },
    {
      "type": "bargauge", "title": "Funil principal", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 } },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [
        { "refId": "A", "expr": "carreiras_business_total{entity=\"leads\"}", "legendFormat": "1. Leads" },
        { "refId": "B", "expr": "carreiras_business_total{entity=\"users\"}", "legendFormat": "2. Usuários" },
        { "refId": "C", "expr": "carreiras_business_total{entity=\"resumes\"}", "legendFormat": "3. Currículos" },
        { "refId": "D", "expr": "carreiras_business_total{entity=\"analyses\"}", "legendFormat": "4. Análises" },
        { "refId": "E", "expr": "carreiras_business_breakdown{metric=\"subscription_status\",value=\"active\"}", "legendFormat": "5. Assinaturas" }
      ]
    },
    {
      "type": "bargauge", "title": "Taxas de conversão", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "green", "value": 0.3 }] } } },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [
        { "refId": "A", "expr": "carreiras_business_total{entity=\"users\"} / clamp_min(carreiras_business_total{entity=\"leads\"}, 1)", "legendFormat": "Lead → usuário" },
        { "refId": "B", "expr": "carreiras_business_total{entity=\"resumes\"} / clamp_min(carreiras_business_total{entity=\"users\"}, 1)", "legendFormat": "Usuário → currículo" },
        { "refId": "C", "expr": "carreiras_business_total{entity=\"analyses\"} / clamp_min(carreiras_business_total{entity=\"resumes\"}, 1)", "legendFormat": "Currículo → análise" },
        { "refId": "D", "expr": "carreiras_business_breakdown{metric=\"subscription_status\",value=\"active\"} / clamp_min(carreiras_business_total{entity=\"users\"}, 1)", "legendFormat": "Usuário → assinatura" }
      ]
    },
    { "type": "row", "title": "Tendência e engajamento", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "Evolução móvel", "gridPos": { "h": 9, "w": 16, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 15 } } },
      "targets": [
        { "refId": "A", "expr": "carreiras_business_created{entity=\"page_views\",period=\"$period\"}", "legendFormat": "visualizações" },
        { "refId": "B", "expr": "carreiras_business_created{entity=\"users\",period=\"$period\"}", "legendFormat": "usuários" },
        { "refId": "C", "expr": "carreiras_business_created{entity=\"analyses\",period=\"$period\"}", "legendFormat": "análises" }
      ]
    },
    {
      "type": "bargauge", "title": "Uso por usuário", "gridPos": { "h": 9, "w": 8, "x": 16, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "min": 0 } },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [
        { "refId": "A", "expr": "carreiras_business_total{entity=\"resumes\"} / clamp_min(carreiras_business_total{entity=\"users\"}, 1)", "legendFormat": "currículos/usuário" },
        { "refId": "B", "expr": "carreiras_business_total{entity=\"analyses\"} / clamp_min(carreiras_business_total{entity=\"users\"}, 1)", "legendFormat": "análises/usuário" },
        { "refId": "C", "expr": "carreiras_business_total{entity=\"applications\"} / clamp_min(carreiras_business_total{entity=\"users\"}, 1)", "legendFormat": "candidaturas/usuário" }
      ]
    }
  ]
}
