// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String                    @id @default(cuid())
  name                        String?
  email                       String?                   @unique
  phone                       String?
  whatsappMarketingOptIn      Boolean                   @default(false)
  emailVerified               DateTime?
  image                       String?
  passwordHash                String?
  careerSegment               String?
  employmentStatus            String?
  professionalArea            String?
  currentProfessionalArea     String?
  targetProfessionalArea      String?
  studyCourse                 String?
  objective                   String?
  objectiveDeadline           String?
  city                        String?
  state                       String?
  preferredWorkModel          String?
  onboardingResumeChoice      String?
  hasFormalEducation          Boolean?
  discoverable                Boolean                   @default(false)
  interestedRoles             String                    @default("[]")
  themePreference             String                    @default("system")
  internshipChecklistProgress String                    @default("[]")
  createdAt                   DateTime                  @default(now())
  firstActionAt               DateTime?
  accounts                    Account[]
  sessions                    Session[]
  resumes                     Resume[]
  jobsAdded                   Job[]
  applications                Application[]
  weeklyGoals                 WeeklyGoal[]
  courses                     UserCourse[]
  payments                    Payment[]
  subscription                Subscription?
  profileSuggestions          ProfileSuggestion[]
  vocationTestResults         VocationTestResult[]
  studyScheduleItems          StudyScheduleItem[]
  classScheduleItems          ClassScheduleItem[]
  softSkillTestResults        SoftSkillTestResult[]
  passwordResetTokens         PasswordResetToken[]
  supportTickets              SupportTicket[]
  freeToolUsages              FreeToolUsage[]
  studyActivityLogs           StudyActivityLog[]
  universityEnrollment        UniversityEnrollment?
  careerGrowthPlan            CareerGrowthPlan?
  featureUsagePeriods         FeatureUsagePeriod[]
  featureUsageReservations    FeatureUsageReservation[]
  creditWallets               CreditWallet[]
  creditTransactions          CreditTransaction[]
  purchases                   Purchase[]
  jobAlerts                   JobAlert[]
  pushSubscriptions           PushSubscription[]
  opportunityReports          OpportunityReport[]
  contactRequests             TalentContactRequest[]
  companyJobApplications      CompanyJobApplication[]
  gameScores                  GameScore[]
  npsResponses                NpsResponse[]
  moodLogs                    MoodLog[]
  professionalEvidences       ProfessionalEvidence[]
  toolReviewResults           ToolReviewResult[]

  autoApplicationSettings AutoApplicationSettings?
  autoApplicationQueue    AutoApplicationQueue[]

  // Marketplace freelancer. Um mesmo User pode ser freelancer (freelancerProfile,
  // propostas) e/ou contratante (projetos que publicou).
  freelancerProfile            FreelancerProfile?
  freelanceProjects            FreelanceProject[]  @relation("ClientProjects")
  freelanceProposals           FreelanceProposal[] @relation("FreelancerProposals")
  freelanceClientContracts     FreelanceContract[] @relation("ClientContracts")
  freelanceFreelancerContracts FreelanceContract[] @relation("FreelancerContracts")
  freelanceReviewsWritten      FreelanceReview[]   @relation("ReviewAuthor")
  freelanceReviewsReceived     FreelanceReview[]   @relation("ReviewTarget")
  freelanceClientThreads       FreelanceThread[]   @relation("ClientThreads")
  freelanceFreelancerThreads   FreelanceThread[]   @relation("FreelancerThreads")
  freelanceMessagesSent        FreelanceMessage[]  @relation("FreelanceMessageSender")

  /// Cupom usado no cadastro (link de indicação ou campo manual). Serve para o
  /// influenciador dono do cupom rastrear quem se cadastrou por indicação dele.
  signupCouponId String?
  signupCoupon   Coupon? @relation("SignupCoupon", fields: [signupCouponId], references: [id], onDelete: SetNull)
  /// Cupom que este usuário é dono (perfil de influenciador). null para usuários comuns.
  ownedCoupon    Coupon? @relation("InfluencerCoupon")

  /// Indicação direta entre usuários (Desafio do Match e convites)
  referredById                  String?
  referredBy                    User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                     User[]  @relation("UserReferrals")
  unlockedFullDiagnosticCredits Int     @default(0)

  @@index([signupCouponId])
  @@index([referredById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Resume {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  rawText    String
  pdfData    Bytes?
  createdAt  DateTime   @default(now())
  analyses   Analysis[]
  jobMatches JobMatch[]
}

model Analysis {
  id                      String                     @id @default(cuid())
  resumeId                String
  resume                  Resume                     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  payments                Payment[]
  leadId                  String?
  lead                    Lead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  careerTrack             String
  jobTitle                String
  jobText                 String
  inferredRequirements    String                     @default("[]")
  overallScore            Int
  technicalScore          Int
  experienceScore         Int
  seniorityScore          Int
  atsScore                Int
  applicationStatus       String
  applicationStatusReason String
  keywordsFound           String
  keywordsMissing         String
  keywordEvidence         String?
  suggestedSummary        String
  strengths               String
  weaknesses              String
  fixes                   String
  interviewQuestions      String
  studyPlan               String
  recruiterMessage        String
  alternativeRoles        String
  talkAboutYourselfAnswer String?
  transferableSkills      String?
  transitionNarrative     String?
  whyCareerChangeAnswer   String?
  bridgeRoles             String?
  recruiterObjections     String?
  applicationStrategy     String?
  weeklyApplicationPlan   String?
  pastFeedback            String?
  feedbackAnalysis        String?
  experienceSuggestions   String                     @default("[]")
  atsChecklist            String                     @default("[]")
  currentSummary          String                     @default("")
  resumeStructured        String                     @default("{}")
  resumeOverride          String?
  actionPlanProgress      String                     @default("[]")
  interviewProgress       String                     @default("{}")
  grammarErrors           String?
  structureRating         String?
  structureFeedback       String?
  missingBasicInfo        String?
  jobDecoded              String?
  jobRedFlags             String?
  clarifyingQuestions     String?
  clarifyingAnswers       String?
  refinedAt               DateTime?
  createdAt               DateTime                   @default(now())
  applications            Application[]
  resumeVersions          ApplicationResumeVersion[]
}

model Job {
  id                   String                 @id @default(cuid())
  url                  String                 @unique
  jobTitle             String
  jobText              String
  location             String?
  city                 String                 @default("")
  state                String                 @default("")
  source               String                 @default("scrape")
  company              String                 @default("")
  area                 String                 @default("")
  subarea              String                 @default("")
  seniority            String                 @default("")
  workModel            String                 @default("")
  contractType         String                 @default("")
  entryLevel           Boolean                @default(false)
  salaryMin            Int?
  expiresAt            DateTime?
  addedByUserId        String?
  addedBy              User?                  @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  matches              JobMatch[]
  applications         Application[]
  autoApplicationQueue AutoApplicationQueue[]

  @@index([active, createdAt])
  @@index([active, entryLevel, createdAt])
  @@index([active, area, createdAt])
  @@index([active, seniority, createdAt])
  @@index([active, workModel, createdAt])
  @@index([active, contractType, createdAt])
  @@index([state, city])
  @@index([active, state, createdAt])
}

model JobMatch {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fitScore  Int
  reason    String
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@unique([resumeId, jobId])
  @@index([resumeId, status, fitScore])
  @@index([jobId])
}

model Application {
  id              String                     @id @default(cuid())
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?                       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  analysisId      String?
  analysis        Analysis?                  @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  company         String                     @default("")
  jobTitle        String
  jobUrl          String                     @default("")
  fitScore        Int?
  status          String                     @default("saved")
  notes           String                     @default("")
  outcomeNote     String                     @default("")
  rejectionReason String                     @default("")
  responseAt      DateTime?
  appliedAt       DateTime?
  deadline        DateTime?
  interviewAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  activities      ApplicationActivity[]
  resumeVersions  ApplicationResumeVersion[]

  @@index([userId, status])
  @@index([userId, jobUrl])
}

model ApplicationResumeVersion {
  id                  String      @id @default(cuid())
  applicationId       String
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  analysisId          String?
  analysis            Analysis?   @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  label               String
  summary             String      @default("")
  resumeStructured    String      @default("{}")
  approvedSuggestions String      @default("[]")
  createdAt           DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@index([analysisId])
}

model ApplicationActivity {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

model ProfessionalEvidence {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  metrics     String?
  verifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, category])
  @@index([userId, createdAt])
}

model UserCourse {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  provider       String    @default("")
  url            String    @default("")
  certificateUrl String    @default("")
  status         String    @default("completed")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model Payment {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String // "first_analysis" | "diagnostic" | "subscription"
  segment       String
  amount        Int // valor em centavos (já com desconto de cupom aplicado, se houver)
  discountCents Int            @default(0) // desconto concedido pelo cupom; amount + discountCents = preço cheio
  status        String         @default("pending") // pending | paid | expired | cancelled | refunded
  mpPaymentId   String         @unique
  analysisId    String? // set for "first_analysis" (consumed by) and "diagnostic" (unlocks) payments
  analysis      Analysis?      @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  couponId      String?
  coupon        Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  paidAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessionId     String         @default("")
  source        String         @default("")
  medium        String         @default("")
  campaign      String         @default("")
  content       String         @default("")
  purchase      Purchase?
  paymentEvents PaymentEvent[]

  @@index([userId])
  @@index([status])
  @@index([analysisId])
  @@index([couponId])
  @@index([campaign, createdAt])
}

model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String
  eventKey    String    @unique
  eventType   String
  resourceId  String
  status      String    @default("received") // received | processed | failed
  paymentId   String?
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([provider, resourceId])
  @@index([status, receivedAt])
}

model AiUsageLog {
  id                String   @id @default(cuid())
  userId            String?
  featureKey        String
  provider          String
  model             String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cachedInputTokens Int      @default(0)
  estimatedCostUsd  Float?
  durationMs        Int
  success           Boolean
  errorType         String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([featureKey, createdAt])
  @@index([provider, model, createdAt])
}

/// Cupons de desconto de influenciadores. Um código por influenciador para rastrear origem das vendas.
model Coupon {
  id             String  @id @default(cuid())
  code           String  @unique
  influencerName String
  active         Boolean @default(true)

  /// "fixed" = usa os campos *DiscountCents; "percent" = usa os campos *DiscountPercent.
  discountType String @default("fixed")

  oneOffDiscountCents         Int @default(200) // desconto em "Primeira Análise" e "Diagnóstico"
  subscriptionDiscountCents   Int @default(400) // desconto na assinatura
  oneOffDiscountPercent       Int @default(0) // 0-100, usado quando discountType = "percent"
  subscriptionDiscountPercent Int @default(0) // 0-100, usado quando discountType = "percent"

  /// Percentual de comissão do influenciador sobre a receita líquida atribuída ao cupom.
  commissionPercent Int @default(0)

  /// null = sem data de expiração.
  expiresAt      DateTime?
  /// null = usos ilimitados. Comparado contra usageCount (resgates pagos).
  maxRedemptions Int?

  /// Só é incrementado quando o pagamento confirma (cartão aprovado ou webhook do PIX).
  usageCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payments   Payment[]

  /// Usuário influenciador dono deste cupom. Ele loga com conta normal e ganha
  /// acesso total ao sistema + o painel /influencer. Um cupom por influenciador.
  ownerUserId String? @unique
  owner       User?   @relation("InfluencerCoupon", fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// Usuários que se cadastraram usando este cupom (indicação), pagos ou não.
  signups     User[]  @relation("SignupCoupon")

  @@index([active])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment          String
  planKey          String    @default("complete")
  status           String    @default("inactive") // inactive | active | expired | cancelled
  currentPeriodEnd DateTime?
  lastPaymentId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  plan             Plan?     @relation(fields: [planKey], references: [key], onDelete: Restrict)
}

model Product {
  id             String     @id @default(cuid())
  code           String     @unique
  name           String
  kind           String
  priceCents     Int
  recurring      Boolean    @default(false)
  planKey        String?
  creditType     String?
  creditQuantity Int?
  active         Boolean    @default(true)
  purchases      Purchase[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Purchase {
  id             String   @id @default(cuid())
  userId         String
  productId      String
  paymentId      String?  @unique
  status         String   @default("pending")
  amountCents    Int
  idempotencyKey String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status])
  @@index([productId, status])
}

model CreditWallet {
  id           String              @id @default(cuid())
  userId       String
  creditType   String
  balance      Int                 @default(0)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, creditType])
}

model CreditTransaction {
  id             String       @id @default(cuid())
  userId         String
  walletId       String
  creditType     String
  quantity       Int
  balanceAfter   Int
  type           String
  source         String
  idempotencyKey String       @unique
  expiresAt      DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet         CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([userId, creditType])
  @@index([walletId, createdAt])
}

model Plan {
  id            String            @id @default(cuid())
  key           String            @unique
  name          String
  priceCents    Int
  recurring     Boolean           @default(true)
  durationDays  Int?
  highlighted   Boolean           @default(false)
  active        Boolean           @default(true)
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model FeatureDefinition {
  id           String            @id @default(cuid())
  key          String            @unique
  name         String
  active       Boolean           @default(true)
  entitlements PlanEntitlement[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model PlanEntitlement {
  id                  String            @id @default(cuid())
  planId              String
  featureDefinitionId String
  limit               Int?
  active              Boolean           @default(true)
  plan                Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureDefinition   FeatureDefinition @relation(fields: [featureDefinitionId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([planId, featureDefinitionId])
  @@index([featureDefinitionId])
}

model ProfileSuggestion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // "course" | "certification" | "book"
  title        String
  provider     String   @default("")
  url          String   @default("")
  priceLabel   String   @default("") // ex: "Gratuito", "R$ 150 - R$ 300"
  impactScore  Int // 0-100, estimativa de impacto no perfil
  impactReason String   @default("")
  gapAddressed String   @default("") // lacuna/objetivo que o item resolve (explica o porquê)
  modality     String   @default("") // só para course: "online" | "presencial" | "híbrido"
  city         String   @default("") // cidade quando presencial
  status       String   @default("pending") // "pending" | "in_progress" | "done"
  createdAt    DateTime @default(now())

  @@unique([userId, title, provider])
  @@index([userId])
}

/// Guarda o resultado gerado por ferramentas de revisão de perfil externo
/// (LinkedIn, GitHub) para o usuário poder voltar depois sem gerar de novo,
/// em vez do resultado só aparecer na tela e sumir.
model ToolReviewResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "linkedin" | "github"
  input     String // resumo do que foi enviado (cargo, url, etc.), pra dar contexto ao reabrir
  result    String // JSON serializado do resultado gerado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model VocationTestResult {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  areaSlug  String
  answers   String
  result    String
  createdAt DateTime @default(now())

  @@index([userId, areaSlug])
  @@index([leadId])
}

// Contato capturado antes de revelar o resultado do teste vocacional ou da análise
// simples de currículo, para visitantes que ainda não têm conta.
model Lead {
  id                  String               @id @default(cuid())
  name                String
  email               String
  phone               String
  source              String // "vocation_test" | "resume_analysis" | "registration"
  sessionId           String               @default("")
  attributionSource   String               @default("")
  medium              String               @default("")
  campaign            String               @default("")
  content             String               @default("")
  createdAt           DateTime             @default(now())
  vocationTestResults VocationTestResult[]
  analyses            Analysis[]

  @@index([email])
}

/// Eventos internos do funil. Não armazena currículo, vaga, e-mail, telefone ou IP.
model FunnelEvent {
  id         String   @id @default(cuid())
  name       String
  sessionId  String   @default("")
  userId     String?
  analysisId String?
  paymentId  String?
  segment    String   @default("")
  source     String   @default("")
  medium     String   @default("")
  campaign   String   @default("")
  content    String   @default("")
  path       String   @default("")
  properties String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([campaign, createdAt])
  @@index([paymentId])
}

model WeeklyGoal {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart          DateTime
  targetApplications Int      @default(8)
  targetResumeTweaks Int      @default(2)
  targetInterviews   Int      @default(3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, weekStart])
}

model StudyScheduleItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaSlug  String
  weekStart DateTime
  focus     String
  task      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, areaSlug])
}

model ClassScheduleItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  subject   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model SoftSkillTestResult {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers          String
  skillScores      String
  personalityType  String
  personalityLabel String
  summary          String   @default("")
  createdAt        DateTime @default(now())

  @@index([userId])
}

/// Registro de e-mails de ciclo de vida já enviados, para garantir idempotência
/// (o scheduler roda várias vezes ao dia e os transacionais disparam em caminho
/// síncrono + webhook). `dedupeKey` identifica unicamente o evento por tipo.
/// Resposta de NPS (0-10) capturada pelo clique no e-mail de pesquisa, sem
/// exigir login: o token na URL identifica o usuário com segurança.
model NpsResponse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  source    String   @default("post_first_analysis")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([score, createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  type      String // "payment_failed" | "subscription_cancelled" | "renewal_reminder" | "subscription_expired" | "onboarding_nudge" | "lead_followup"
  dedupeKey String
  email     String
  createdAt DateTime @default(now())

  @@unique([type, dedupeKey])
  @@index([email])
}

/// Mesma função do EmailLog (trava de idempotência), mas para a régua de WhatsApp:
/// tabela separada porque a chave de contato é o telefone, não o e-mail.
model WhatsappLog {
  id        String   @id @default(cuid())
  type      String // "convert_to_subscription" | "convert_second_nudge" | "urgency_coupon"
  dedupeKey String
  phone     String
  createdAt DateTime @default(now())

  @@unique([type, dedupeKey])
  @@index([phone])
}

/// Números/instâncias da Evolution API disponíveis pra envio. Suporta mais de
/// um número pareado (rotação e failover), pra não ficar 100% parado se um
/// deles for banido/desconectado.
model WhatsappInstance {
  id           String   @id @default(cuid())
  label        String
  instanceName String   @unique
  createdAt    DateTime @default(now())
}

/// Configurações operacionais editáveis pela tela de admin (ex.: qual modelo da Groq usar).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Posts do blog gerados automaticamente por IA, um por nicho em rodízio.
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  areaSlug    String
  areaLabel   String
  coverEmoji  String
  gradientIdx Int      @default(0)
  contentJson String // JSON.stringify(ContentBlock[])
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([areaSlug])
}

/// Ticket de suporte: uma conversa entre um usuário e o admin, dentro do sistema.
model SupportTicket {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  category        String           @default("other")
  status          String           @default("open")
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  reopenCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

/// Mensagem dentro de um ticket. `fromAdmin` diz de que lado veio.
model SupportMessage {
  id          String              @id @default(cuid())
  ticketId    String
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin   Boolean             @default(false)
  body        String
  readByUser  Boolean             @default(false)
  readByAdmin Boolean             @default(false)
  createdAt   DateTime            @default(now())
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
}

/// Arquivo pequeno enviado em uma conversa de suporte. Os bytes ficam no banco
/// e só são entregues por uma rota autenticada, nunca por uma pasta pública.
model SupportAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime       @default(now())

  @@index([messageId])
}

/// Page views anonimos para medir aquisicao e campanhas sem armazenar IP ou dados pessoais.
model PageView {
  id           String   @id @default(cuid())
  sessionId    String
  path         String
  referrerHost String   @default("")
  source       String   @default("")
  medium       String   @default("")
  campaign     String   @default("")
  content      String   @default("")
  term         String   @default("")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@index([campaign, createdAt])
  @@index([path, createdAt])
}

model FreeToolUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      String
  createdAt DateTime @default(now())

  @@unique([userId, tool])
  @@index([createdAt])
}

/**
 * Log de uso das ferramentas de estudo (simulados, redação, flashcards, edital, OAB).
 * Ao contrário de FreeToolUsage (1 linha por ferramenta, para gate de uso grátis),
 * aqui cada uso gera uma linha nova — é o que alimenta o "plano de estudos da semana"
 * no dashboard para quem tem objetivo de estudo (student/concurseiro/oab).
 */
model StudyActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      String
  score     Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ExternalCourse {
  id          String   @id @default(cuid())
  title       String
  provider    String
  url         String   @unique
  area        String
  subarea     String   @default("")
  city        String   @default("")
  state       String   @default("")
  modality    String   @default("online")
  free        Boolean  @default(true)
  certificate Boolean  @default(false)
  active      Boolean  @default(true)
  source      String
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partnerId      String?
  partner        Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  featured       Boolean  @default(false)
  couponCode     String   @default("")
  couponDiscount String   @default("")

  @@index([active, area])
  @@index([state, city])
  @@index([source, lastSeenAt])
  @@index([partnerId])
}

model University {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  nationalCode      String?   @unique
  city              String    @default("")
  state             String    @default("")
  website           String    @default("")
  category          String    @default("")
  organization      String    @default("")
  priority          Int       @default(100)
  discoveryStatus   String    @default("pending")
  discoveryError    String?
  catalogLastSeenAt DateTime?
  source            String
  active            Boolean   @default(true)
  lastSeenAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  courses    UniversityCourse[]
  scrapeJobs UniversityScrapeJob[]
  partners   Partner[]

  @@index([state, city])
}

model UniversityCourse {
  id                String     @id @default(cuid())
  universityId      String
  university        University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title             String
  slug              String     @unique
  nationalCode      String?
  degree            String     @default("")
  campus            String     @default("")
  area              String
  subarea           String     @default("")
  url               String     @unique
  modality          String     @default("presencial")
  active            Boolean    @default(true)
  source            String
  lastSeenAt        DateTime   @default(now())
  catalogLastSeenAt DateTime?
  collectionStatus  String     @default("pending")
  collectionError   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  subjects    CurriculumSubject[]
  enrollments UniversityEnrollment[]
  scrapeJobs  UniversityScrapeJob[]

  @@index([universityId])
  @@index([active, area])
  @@index([source, lastSeenAt])
}

/// Fila persistente para processar fontes nacionais gradualmente.
model UniversityScrapeJob {
  id                 String            @id @default(cuid())
  universityId       String
  university         University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  universityCourseId String?
  universityCourse   UniversityCourse? @relation(fields: [universityCourseId], references: [id], onDelete: Cascade)
  url                String
  adapter            String            @default("auto")
  status             String            @default("pending")
  priority           Int               @default(100)
  attempts           Int               @default(0)
  nextAttemptAt      DateTime          @default(now())
  lastAttemptAt      DateTime?
  processedAt        DateTime?
  lastError          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([universityId, url])
  @@index([status, nextAttemptAt, priority])
  @@index([universityId, status])
}

model CurriculumSubject {
  id                 String           @id @default(cuid())
  universityCourseId String
  universityCourse   UniversityCourse @relation(fields: [universityCourseId], references: [id], onDelete: Cascade)
  name               String
  semester           Int?
  order              Int              @default(0)
  createdAt          DateTime         @default(now())

  insight       CurriculumSubjectInsight?
  exercises     CurriculumSubjectExerciseSet?
  studyMaterial CurriculumSubjectStudyMaterial?

  @@index([universityCourseId])
}

/**
 * Conexão com carreira de uma disciplina do catálogo real (competências, profissões
 * relacionadas, projeto sugerido), gerada por IA e cacheada aqui — como a disciplina é
 * compartilhada entre todos os alunos do mesmo curso, gera-se uma vez só por disciplina,
 * não por usuário.
 */
model CurriculumSubjectInsight {
  id                  String            @id @default(cuid())
  curriculumSubjectId String            @unique
  curriculumSubject   CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)
  competencies        String
  relatedProfessions  String
  suggestedProject    String
  generatedAt         DateTime          @default(now())
}

/**
 * Lista de exercícios (múltipla escolha) de uma disciplina do catálogo real, gerada
 * por IA e cacheada aqui — mesmo raciocínio de CurriculumSubjectInsight: como a
 * disciplina é compartilhada entre todos os alunos do curso, gera-se uma vez só.
 * `questions` é um array JSON de { question, options, correctIndex, explanation }.
 */
model CurriculumSubjectExerciseSet {
  id                  String            @id @default(cuid())
  curriculumSubjectId String            @unique
  curriculumSubject   CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)
  questions           String
  generatedAt         DateTime          @default(now())
}

/**
 * Material de estudo (resumo, tópicos e pontos-chave) de uma disciplina do catálogo
 * real, gerado por IA e cacheado aqui — mesmo raciocínio de CurriculumSubjectExerciseSet:
 * compartilhado entre todos os alunos do curso, gera-se uma vez só.
 */
model CurriculumSubjectStudyMaterial {
  id                  String            @id @default(cuid())
  curriculumSubjectId String            @unique
  curriculumSubject   CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)
  summary             String
  topics              String
  keyPoints           String
  generatedAt         DateTime          @default(now())
}

/**
 * Matrícula do usuário: curso e período atual. Quando `universityCourseId` está
 * preenchido, o curso foi encontrado no catálogo real (SIGAA) e "minhas disciplinas"
 * vem de `CurriculumSubject` filtrado pelo período; sem match no catálogo, o usuário
 * cadastra as disciplinas manualmente em `UniversitySubject`.
 */
model UniversityEnrollment {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        String            @default("")
  courseName         String            @default("")
  period             String            @default("")
  universityCourseId String?
  universityCourse   UniversityCourse? @relation(fields: [universityCourseId], references: [id], onDelete: SetNull)
  currentSemester    Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  manualSubjects UniversitySubject[]
}

/**
 * Disciplina cadastrada manualmente (curso fora do catálogo). Insight fica aqui mesmo
 * (por usuário) — diferente de CurriculumSubjectInsight, que é compartilhado.
 */
model UniversitySubject {
  id                       String               @id @default(cuid())
  enrollmentId             String
  enrollment               UniversityEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  name                     String
  /// Trecho da ementa/grade extraído de um PDF enviado pelo aluno, usado como contexto
  /// extra ao gerar insight, exercícios e material de estudo (quando presente).
  syllabus                 String?
  competencies             String?
  relatedProfessions       String?
  suggestedProject         String?
  generatedAt              DateTime?
  exercises                String?
  exercisesGeneratedAt     DateTime?
  studyMaterialSummary     String?
  studyMaterialTopics      String?
  studyMaterialKeyPoints   String?
  studyMaterialGeneratedAt DateTime?
  createdAt                DateTime             @default(now())

  @@index([enrollmentId])
}

/**
 * Plano de evolução profissional dentro do emprego atual: cargo atual → próximo
 * cargo. Diferente do restante do produto (focado em conquistar a PRÓXIMA vaga
 * externa), isso é sobre crescer onde a pessoa já está — por isso vive fora do
 * fluxo de Analysis/Application. Gerado por IA e cacheado por usuário (não é
 * compartilhável entre usuários como o insight de disciplina, já que depende do
 * cargo/senioridade específicos da pessoa).
 */
model CareerGrowthPlan {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole              String
  currentSeniority         String    @default("")
  targetRole               String
  competencyGaps           String?
  developmentActions       String?
  negotiationTalkingPoints String?
  leadershipReadiness      String?
  generatedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

/**
 * Núcleo do sistema de permissões do Plano Mestre 2026 (seções 15-16): consumo de
 * feature por usuário dentro de um ciclo (mês corrente). `featureKey` usa o padrão
 * `dominio.recurso.acao` já definido em `src/lib/commercial-plan-catalog.ts`
 * (CommercialFeatureKey) — este model não redefine o catálogo de features (isso
 * continua sendo código, não dado), só registra o USO real por usuário/ciclo.
 */
model FeatureUsagePeriod {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  records      FeatureUsageRecord[]
  reservations FeatureUsageReservation[]

  @@unique([userId, periodStart])
  @@index([userId])
}

model FeatureUsageRecord {
  id         String             @id @default(cuid())
  periodId   String
  period     FeatureUsagePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  featureKey String
  count      Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([periodId, featureKey])
}

/// Reserva idempotente de consumo. A reserva fica pendente durante a operação
/// cara e só vira uso confirmado quando a operação termina com sucesso.
model FeatureUsageReservation {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodId            String
  period              FeatureUsagePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  featureKey          String
  idempotencyKey      String
  quantity            Int
  creditTransactionId String?
  status              String             @default("reserved") // reserved | confirmed | cancelled
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([periodId, featureKey, status])
  @@index([userId, featureKey, status])
}

model CareerVideo {
  id          String    @id @default(cuid())
  videoId     String    @unique
  title       String
  channel     String
  description String    @default("")
  thumbnail   String    @default("")
  area        String
  subarea     String    @default("")
  durationSec Int       @default(0)
  publishedAt DateTime?
  active      Boolean   @default(true)
  source      String    @default("youtube")
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, area])
  @@index([source, lastSeenAt])
}

model RadarItem {
  id          String    @id @default(cuid())
  kind        String
  title       String
  url         String    @unique
  source      String
  summary     String    @default("")
  publishedAt DateTime?
  active      Boolean   @default(true)
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind, active, publishedAt])
  @@index([source, lastSeenAt])
}

model PublicJobBulletin {
  id          String    @id @default(cuid())
  title       String
  url         String    @unique
  source      String
  city        String
  state       String
  publishedAt DateTime?
  active      Boolean   @default(true)
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, state, city])
  @@index([source, publishedAt])
}

model SourceSync {
  key           String    @id
  label         String
  kind          String
  active        Boolean   @default(true)
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  itemCount     Int       @default(0)
  lastError     String    @default("")
  updatedAt     DateTime  @updatedAt
}

model OpportunitySource {
  id            String              @id @default(cuid())
  name          String
  url           String              @unique
  kind          String              @default("job")
  parser        String              @default("links")
  state         String              @default("")
  city          String              @default("")
  active        Boolean             @default(true)
  official      Boolean             @default(true)
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String              @default("")
  itemCount     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  opportunities PublicOpportunity[]

  @@index([active, kind])
  @@index([state, city])
}

model PublicOpportunity {
  id            String              @id @default(cuid())
  sourceId      String
  source        OpportunitySource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalKey   String
  title         String
  company       String              @default("")
  description   String              @default("")
  url           String
  city          String              @default("")
  state         String              @default("")
  area          String              @default("")
  subarea       String              @default("")
  education     String              @default("")
  experience    String              @default("")
  salary        String              @default("")
  quantity      Int?
  publishedAt   DateTime?
  expiresAt     DateTime?
  official      Boolean             @default(true)
  riskScore     Int                 @default(0)
  riskReasons   String              @default("[]")
  linkStatus    String              @default("unknown")
  lastCheckedAt DateTime?
  active        Boolean             @default(true)
  lastSeenAt    DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  clicks        OpportunityClick[]
  reports       OpportunityReport[]

  @@unique([sourceId, externalKey])
  @@index([active, state, city])
  @@index([active, area, publishedAt])
  @@index([active, expiresAt])
}

model JobAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String   @default("")
  city      String   @default("")
  state     String   @default("")
  frequency String   @default("daily")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
}

/// Inscrição de Web Push (PushSubscription do browser). Um usuário pode ter
/// várias (um por dispositivo/navegador). `endpoint` é único e identifica a
/// inscrição; quando o push retorna 404/410 a inscrição está morta e é removida.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

model OpportunityClick {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   PublicOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sessionId     String            @default("")
  campaign      String            @default("")
  createdAt     DateTime          @default(now())

  @@index([opportunityId, createdAt])
  @@index([campaign, createdAt])
}

model OpportunityReport {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   PublicOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason        String
  details       String            @default("")
  status        String            @default("open")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([opportunityId])
}

model PartnerSubmission {
  id               String   @id @default(cuid())
  organization     String
  organizationType String
  contactName      String
  email            String
  phone            String   @default("")
  title            String
  description      String
  url              String   @default("")
  state            String   @default("")
  city             String   @default("")
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
  @@index([state, city])
}

/// Conta de empresa (empregador). Autenticação própria, isolada da conta de
/// candidato (User): senha própria em `passwordHash`, login via provider
/// "company-credentials" do NextAuth.
model Company {
  id                   String                 @id @default(cuid())
  name                 String
  cnpj                 String                 @default("")
  email                String                 @unique
  passwordHash         String
  logoUrl              String                 @default("")
  phone                String                 @default("")
  city                 String                 @default("")
  state                String                 @default("")
  /// Quantas triagens gratuitas já usou; conta contra FREE_SCREENING_LIMIT.
  screeningCount       Int                    @default(0)
  /// Créditos de triagem comprados; consumidos quando o teto gratuito acaba.
  screeningCredits     Int                    @default(0)
  /// Plano recorrente (vagas + triagens dentro da cota mensal). "inactive" | "active" | "cancelled".
  planStatus           String                 @default("inactive")
  /// "starter" | "pro". Null quando planStatus é "inactive".
  planKind             String?
  /// Triagens já usadas dentro da cota do plano no ciclo atual; zera a cada renovação.
  planScreeningsUsed   Int                    @default(0)
  planCurrentPeriodEnd DateTime?
  /// Página pública da empresa (marca empregadora). slug único quando ativa.
  slug                 String?                @unique
  publicProfile        Boolean                @default(false)
  description          String                 @default("")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  jobs                 CompanyJob[]
  vagas                CompanyVaga[]
  contactRequests      TalentContactRequest[]
  payments             CompanyPayment[]
  members              CompanyMember[]

  @@index([email])
}

/// Usuário de login de uma empresa. A empresa passa a ser a organização e os
/// membros são as identidades que autenticam. Company.email/passwordHash ficam
/// como legado (o membro "owner" espelha o cadastro original).
model CompanyMember {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String   @default("")
  email        String   @unique
  passwordHash String
  role         String   @default("member") // owner | member
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

/// Vaga cadastrada pela empresa para puxar candidatos do banco de talentos
/// (usuários discoverable) automaticamente pela aderência. Diferente de
/// CompanyJob, que é a triagem de PDFs enviados manualmente pela empresa.
model CompanyVaga {
  id              String                  @id @default(cuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  description     String
  area            String                  @default("")
  subarea         String                  @default("")
  state           String                  @default("")
  status          String                  @default("open") // open | closed
  /// Campos opcionais que enriquecem o anúncio e o feed.
  salaryMin       Int?
  workModel       String                  @default("") // presencial | hibrido | remoto
  seniority       String                  @default("") // estagio | junior | pleno | senior
  jobType         String                  @default("") // clt | pj | estagio | temporario
  /// Snapshot do último matching, sem dados de contato: JSON de
  /// { userId, firstName, professionalArea, city, state, fitScore, reason }.
  /// O status do contato e o contato em si são resolvidos ao vivo na leitura.
  matchesJson     String                  @default("")
  lastMatchedAt   DateTime?
  /// Publicada no feed público de vagas? Quando true, existe um Job espelho.
  publishedToFeed Boolean                 @default(false)
  /// Id do Job (feed) espelho desta vaga, quando publicada.
  feedJobId       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  applications    CompanyJobApplication[]

  @@index([companyId, createdAt])
}

/// Candidatura de um candidato a uma vaga de empresa publicada no feed.
model CompanyJobApplication {
  id        String      @id @default(cuid())
  vagaId    String
  vaga      CompanyVaga @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String      @default("")
  status    String      @default("new") // new | reviewing | interview | approved | rejected
  /// Anotação interna da empresa sobre a candidatura.
  note      String      @default("")
  /// Aderência calculada por IA entre o currículo do candidato e a vaga no
  /// momento da candidatura (mesmo motor de ranking do banco de talentos).
  /// Null quando ainda não foi possível calcular (ex.: candidato sem currículo).
  fitScore  Int?
  fitReason String      @default("")
  createdAt DateTime    @default(now())

  @@unique([vagaId, userId])
  @@index([vagaId, createdAt])
}

/// Pagamento de empresa (compra de pacote de créditos de triagem). Espelha o
/// fluxo do Payment do candidato, mas escopado à Company e com concessão de
/// créditos em vez de assinatura.
model CompanyPayment {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String // "screening_pack" | "company_subscription"
  credits     Int // créditos concedidos ao confirmar o pagamento (0 para assinatura)
  amount      Int // valor em centavos
  status      String    @default("pending") // pending | paid | cancelled | refunded
  mpPaymentId String    @unique
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
}

/// Uma triagem: a vaga que a empresa descreveu para ranquear currículos.
model CompanyJob {
  id                      String             @id @default(cuid())
  companyId               String
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                   String
  description             String
  recommendation          String             @default("")
  /// JSON string[] de requisitos eliminatórios (estilo Gupy): candidato sem
  /// evidência de um deles é sinalizado como eliminado no ranking.
  eliminatoryRequirements String             @default("[]")
  createdAt               DateTime           @default(now())
  candidates              CompanyCandidate[]

  @@index([companyId, createdAt])
}

/// Um currículo enviado numa triagem, já pontuado contra a vaga.
model CompanyCandidate {
  id                String     @id @default(cuid())
  jobId             String
  job               CompanyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileName          String
  candidateName     String     @default("")
  rawText           String
  fitScore          Int        @default(0)
  reason            String     @default("")
  /// Ação da empresa sobre o candidato: none | favorite | approved | rejected.
  status            String     @default("none")
  /// Anotação interna da empresa sobre o candidato.
  note              String     @default("")
  /// Reprovado automaticamente por requisito eliminatório da vaga.
  eliminated        Boolean    @default(false)
  eliminationReason String     @default("")
  createdAt         DateTime   @default(now())

  @@index([jobId, fitScore])
}

/// Pedido de contato de uma empresa a um candidato do banco de talentos.
/// O contato do candidato só é liberado para a empresa quando o candidato aceita
/// (status "accepted") — dupla proteção de consentimento (opt-in + aceite).
model TalentContactRequest {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle        String    @default("")
  message         String    @default("")
  status          String    @default("pending") // pending | accepted | declined
  /// A empresa já viu que este pedido foi aceito? Zera o aviso in-app.
  viewedByCompany Boolean   @default(false)
  /// Anotação interna da empresa sobre este contato.
  note            String    @default("")
  /// Entrevista agendada pela empresa (quando o contato foi liberado).
  interviewAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, userId])
  @@index([userId, status])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Marketplace freelancer. Paralelo ao fluxo de emprego (Company/CompanyVaga),
// mas 100% entre usuários comuns: qualquer User pode virar freelancer e/ou
// contratar. Grátis por enquanto — o contrato registra o acordo para habilitar
// entrega e avaliações, sem movimentar dinheiro (escrow fica para depois).
// ---------------------------------------------------------------------------

/// Perfil de freelancer de um usuário (opt-in). Um por User. Guarda a vitrine
/// (skills, portfólio, valor) e as métricas de reputação, atualizadas quando
/// uma avaliação é criada.
model FreelancerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String   @default("")
  bio             String   @default("")
  category        String   @default("")
  /// JSON string[] de habilidades.
  skills          String   @default("[]")
  /// Valor/hora em centavos. null = "a combinar".
  hourlyRateCents Int?
  /// Chave Pix usada para o repasse do freelancer (nunca exibida na vitrine).
  pixKey          String   @default("")
  /// JSON de { title, url, imageUrl, description }[].
  portfolio       String   @default("[]")
  /// Aceitando novos projetos? Controla visibilidade na vitrine.
  available       Boolean  @default(true)
  published       Boolean  @default(false)
  /// Reputação desnormalizada a partir de FreelanceReview (direção → freelancer).
  ratingSum       Int      @default(0)
  ratingCount     Int      @default(0)
  completedCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, available, category])
}

/// Projeto publicado por um contratante (User). O ciclo é
/// open → (proposta aceita) in_progress → completed | cancelled.
model FreelanceProject {
  id             String              @id @default(cuid())
  clientUserId   String
  client         User                @relation("ClientProjects", fields: [clientUserId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       String              @default("")
  /// JSON string[] de habilidades desejadas.
  skills         String              @default("[]")
  /// "fixed" | "hourly".
  budgetType     String              @default("fixed")
  budgetMinCents Int?
  budgetMaxCents Int?
  workModel      String              @default("remoto") // remoto | presencial | hibrido
  deadline       DateTime?
  status         String              @default("open") // open | in_progress | completed | cancelled
  proposalCount  Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  proposals      FreelanceProposal[]
  contract       FreelanceContract?
  threads        FreelanceThread[]

  @@index([status, createdAt])
  @@index([status, category, createdAt])
  @@index([clientUserId, createdAt])
}

/// Proposta de um freelancer a um projeto. Um freelancer só propõe uma vez por
/// projeto.
model FreelanceProposal {
  id               String             @id @default(cuid())
  projectId        String
  project          FreelanceProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerUserId String
  freelancer       User               @relation("FreelancerProposals", fields: [freelancerUserId], references: [id], onDelete: Cascade)
  coverLetter      String
  bidCents         Int
  estimatedDays    Int?
  status           String             @default("pending") // pending | accepted | rejected | withdrawn
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  contract         FreelanceContract?

  @@unique([projectId, freelancerUserId])
  @@index([freelancerUserId, status])
  @@index([projectId, createdAt])
}

/// Acordo criado quando uma proposta é aceita. Um por projeto. Habilita a
/// entrega e as avaliações mútuas. Sem pagamento real por enquanto.
model FreelanceContract {
  id                    String            @id @default(cuid())
  projectId             String            @unique
  project               FreelanceProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId            String            @unique
  proposal              FreelanceProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientUserId          String
  client                User              @relation("ClientContracts", fields: [clientUserId], references: [id], onDelete: Cascade)
  freelancerUserId      String
  freelancer            User              @relation("FreelancerContracts", fields: [freelancerUserId], references: [id], onDelete: Cascade)
  agreedCents           Int
  /// Comissão da plataforma (5% do valor bruto), congelada no aceite.
  platformFeeCents      Int               @default(0)
  /// Valor líquido devido ao freelancer após a comissão.
  freelancerPayoutCents Int               @default(0)
  paymentStatus         String            @default("pending") // pending | paid | cancelled | refunded
  mpPaymentId           String?           @unique
  paymentPaidAt         DateTime?
  freelancerConfirmedAt DateTime?
  clientConfirmedAt     DateTime?
  payoutStatus          String            @default("waiting") // waiting | ready | released
  payoutReleasedAt      DateTime?
  status                String            @default("active") // active | delivered | completed | cancelled
  deliveredAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reviews               FreelanceReview[]

  @@index([clientUserId, status])
  @@index([freelancerUserId, status])
}

/// Avaliação mútua após a conclusão de um contrato. Cada parte avalia a outra
/// uma vez. `direction` diz de que lado veio.
model FreelanceReview {
  id           String            @id @default(cuid())
  contractId   String
  contract     FreelanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User              @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User              @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  direction    String // client_to_freelancer | freelancer_to_client
  rating       Int // 1-5
  comment      String            @default("")
  createdAt    DateTime          @default(now())

  @@unique([contractId, authorUserId])
  @@index([targetUserId, createdAt])
}

/// Conversa entre o contratante e um freelancer no contexto de um projeto.
model FreelanceThread {
  id               String             @id @default(cuid())
  projectId        String
  project          FreelanceProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientUserId     String
  client           User               @relation("ClientThreads", fields: [clientUserId], references: [id], onDelete: Cascade)
  freelancerUserId String
  freelancer       User               @relation("FreelancerThreads", fields: [freelancerUserId], references: [id], onDelete: Cascade)
  lastMessageAt    DateTime           @default(now())
  createdAt        DateTime           @default(now())
  messages         FreelanceMessage[]

  @@unique([projectId, freelancerUserId])
  @@index([clientUserId, lastMessageAt])
  @@index([freelancerUserId, lastMessageAt])
}

/// Mensagem dentro de uma FreelanceThread.
model FreelanceMessage {
  id               String          @id @default(cuid())
  threadId         String
  thread           FreelanceThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId     String
  sender           User            @relation("FreelanceMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  body             String
  readByClient     Boolean         @default(false)
  readByFreelancer Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([threadId, createdAt])
}

model Partner {
  id           String           @id @default(cuid())
  name         String
  cnpj         String           @default("")
  email        String           @unique
  passwordHash String
  logoUrl      String           @default("")
  website      String           @default("")
  description  String           @default("")
  status       String           @default("active") // pending | active | suspended
  credits      Int              @default(0) // créditos para destacar cursos
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  courses      ExternalCourse[]
  payments     PartnerPayment[]

  /// Vínculo opcional e auto-declarado com uma instituição do catálogo real (scraper
  /// SIGAA), pra habilitar o painel agregado de empregabilidade. Autodeclarado (o
  /// parceiro busca e escolhe a própria instituição) — por isso o painel só mostra
  /// métricas AGREGADAS (nunca aluno individual), já que não há verificação formal
  /// desse vínculo além do já existente `status` de aprovação do parceiro.
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@index([email])
}

model PartnerPayment {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  kind        String // "ad_pack"
  credits     Int // créditos concedidos ao confirmar o pagamento
  amount      Int // valor em centavos
  status      String    @default("pending") // pending | paid | cancelled | refunded
  mpPaymentId String    @unique
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([partnerId])
  @@index([status])
}

model PartnerCourseClick {
  id        String   @id @default(cuid())
  courseId  String
  partnerId String
  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([courseId])
}

model PartnerLead {
  id        String   @id @default(cuid())
  partnerId String
  courseId  String
  name      String
  email     String
  phone     String
  status    String   @default("new") // new | contacted
  createdAt DateTime @default(now())

  @@index([partnerId, status])
  @@index([courseId])
}

model GameScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String // typer | quiz | memory
  area      String
  score     Int
  createdAt DateTime @default(now())

  @@index([game, createdAt, score])
  @@index([userId])
}

model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      String // great | good | neutral | low | rough
  dayKey    String // "YYYY-MM-DD" no fuso do usuário, garante 1 check-in por dia
  createdAt DateTime @default(now())

  @@unique([userId, dayKey])
  @@index([userId, createdAt])
}

model AutoApplicationSettings {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled                   Boolean   @default(false)
  minMatchScore             Int       @default(75)
  autoTailorResume          Boolean   @default(true)
  externalAutomationEnabled Boolean   @default(false)
  applicationProfile        String    @default("{}")
  preferredPlatforms        String    @default("[\"linkedin\", \"gupy\", \"indeed\"]")
  dailyLimit                Int       @default(10)
  notifyOnApplication       Boolean   @default(true)
  consentedAt               DateTime?
  externalConsentedAt       DateTime?
  lastRunAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model AutoApplicationQueue {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId            String?
  job              Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobTitle         String
  company          String
  jobUrl           String
  fitScore         Int
  status           String    @default("queued") // queued | processing | applied | failed | unsupported_external | blocked_external
  tailoredResumeId String?
  failureReason    String?
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
}
