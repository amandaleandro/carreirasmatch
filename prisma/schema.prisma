// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  careerSegment      String?
  professionalArea   String?
  hasFormalEducation Boolean?
  interestedRoles    String    @default("[]")
  themePreference    String    @default("system")
  internshipChecklistProgress String @default("[]")
  createdAt          DateTime  @default(now())
  accounts           Account[]
  sessions           Session[]
  resumes            Resume[]
  jobsAdded          Job[]
  applications       Application[]
  weeklyGoals        WeeklyGoal[]
  courses            UserCourse[]
  payments           Payment[]
  subscription       Subscription?
  profileSuggestions ProfileSuggestion[]
  vocationTestResults VocationTestResult[]
  studyScheduleItems StudyScheduleItem[]
  classScheduleItems ClassScheduleItem[]
  softSkillTestResults SoftSkillTestResult[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Resume {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  rawText    String
  pdfData    Bytes?
  createdAt  DateTime   @default(now())
  analyses   Analysis[]
  jobMatches JobMatch[]
}

model Analysis {
  id             String   @id @default(cuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  payments       Payment[]
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  careerTrack    String
  jobTitle       String
  jobText        String
  overallScore   Int
  technicalScore Int
  experienceScore Int
  seniorityScore Int
  atsScore       Int
  applicationStatus       String
  applicationStatusReason String
  keywordsFound  String
  keywordsMissing String
  suggestedSummary String
  strengths      String
  weaknesses     String
  fixes          String
  interviewQuestions String
  studyPlan      String
  recruiterMessage String
  alternativeRoles String
  talkAboutYourselfAnswer String?
  transferableSkills      String?
  transitionNarrative     String?
  whyCareerChangeAnswer   String?
  bridgeRoles             String?
  recruiterObjections     String?
  applicationStrategy     String?
  weeklyApplicationPlan   String?
  pastFeedback            String?
  feedbackAnalysis        String?
  experienceSuggestions   String   @default("[]")
  atsChecklist            String   @default("[]")
  currentSummary          String   @default("")
  resumeStructured        String   @default("{}")
  resumeOverride          String?
  actionPlanProgress      String   @default("[]")
  interviewProgress       String   @default("{}")
  createdAt      DateTime @default(now())
  applications   Application[]
}

model Job {
  id            String     @id @default(cuid())
  url           String     @unique
  jobTitle      String
  jobText       String
  location      String?
  source        String     @default("scrape")
  addedByUserId String?
  addedBy       User?      @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  matches       JobMatch[]
  applications  Application[]

  @@index([active, createdAt])
}

model JobMatch {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fitScore  Int
  reason    String
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@unique([resumeId, jobId])
  @@index([resumeId, status, fitScore])
  @@index([jobId])
}

model Application {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  company    String   @default("")
  jobTitle   String
  jobUrl     String   @default("")
  fitScore   Int?
  status     String   @default("saved")
  notes      String   @default("")
  appliedAt  DateTime?
  deadline   DateTime?
  interviewAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activities ApplicationActivity[]

  @@index([userId, status])
  @@index([userId, jobUrl])
}

model ApplicationActivity {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

model UserCourse {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  provider       String    @default("")
  url            String    @default("")
  certificateUrl String    @default("")
  status         String    @default("completed")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model Payment {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             String // "first_analysis" | "diagnostic" | "subscription"
  segment          String
  amount           Int // valor em centavos (já com desconto de cupom aplicado, se houver)
  status           String    @default("pending") // pending | paid | expired | cancelled | refunded
  mpPaymentId      String    @unique
  analysisId       String? // set for "first_analysis" (consumed by) and "diagnostic" (unlocks) payments
  analysis         Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  couponId         String?
  coupon           Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([analysisId])
  @@index([couponId])
}

/// Cupons de desconto de influenciadores. Um código por influenciador para rastrear origem das vendas.
model Coupon {
  id                        String    @id @default(cuid())
  code                      String    @unique
  influencerName            String
  active                    Boolean   @default(true)
  oneOffDiscountCents       Int       @default(200) // desconto em "Primeira Análise" e "Diagnóstico"
  subscriptionDiscountCents Int       @default(400) // desconto na assinatura
  usageCount                Int       @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  payments                  Payment[]

  @@index([active])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment          String
  status           String    @default("inactive") // inactive | active | expired | cancelled
  currentPeriodEnd DateTime?
  lastPaymentId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ProfileSuggestion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // "course" | "certification" | "book"
  title        String
  provider     String   @default("")
  url          String   @default("")
  priceLabel   String   @default("") // ex: "Gratuito", "R$ 150 - R$ 300"
  impactScore  Int // 0-100, estimativa de impacto no perfil
  impactReason String   @default("")
  createdAt    DateTime @default(now())

  @@index([userId])
}

model VocationTestResult {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  areaSlug  String
  answers   String
  result    String
  createdAt DateTime @default(now())

  @@index([userId, areaSlug])
  @@index([leadId])
}

// Contato capturado antes de revelar o resultado do teste vocacional ou da análise
// simples de currículo, para visitantes que ainda não têm conta.
model Lead {
  id                  String               @id @default(cuid())
  name                String
  email               String
  phone               String
  source              String // "vocation_test" | "resume_analysis"
  createdAt           DateTime             @default(now())
  vocationTestResults VocationTestResult[]
  analyses            Analysis[]

  @@index([email])
}

model WeeklyGoal {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart          DateTime
  targetApplications Int      @default(8)
  targetResumeTweaks Int      @default(2)
  targetInterviews   Int      @default(3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, weekStart])
}

model StudyScheduleItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaSlug  String
  weekStart DateTime
  focus     String
  task      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, areaSlug])
}

model ClassScheduleItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  subject   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model SoftSkillTestResult {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         String
  skillScores     String
  personalityType String
  personalityLabel String
  summary         String   @default("")
  createdAt       DateTime @default(now())

  @@index([userId])
}

/// Configurações operacionais editáveis pela tela de admin (ex.: qual modelo da Groq usar).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Posts do blog gerados automaticamente por IA, um por nicho em rodízio.
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  areaSlug    String
  areaLabel   String
  coverEmoji  String
  gradientIdx Int      @default(0)
  contentJson String // JSON.stringify(ContentBlock[])
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([areaSlug])
}
